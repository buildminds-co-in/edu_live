    "db:migrate:prod": "wrangler d1 migrations apply edu-live-db --remote --env production",
    "db:check": "node scripts/check-migrations.js",
    "db:backup:prod": "node scripts/backup-prod.js",
    "eval": "node evals/run-evals.js"
  },
